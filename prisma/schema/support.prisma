// @@schema("support") — File, Notification, AuditLogEntry, outbox_event
// (docs/technical/02-PROYECTOS.md §2.5, docs/technical/04-PERSISTENCE.md §4).
// File/Notification/AuditLogEntry siguen vacios a proposito (Audit es Fase 0 item 7,
// todavia no construido) - solo se agrega OutboxEvent, infra transversal de la que
// Identity & Access ya depende para escribir sus eventos de forma atomica con el cambio de
// estado (docs/technical/04-PERSISTENCE.md SS4). Sin OutboxRelayWorker todavia (BullMQ) -
// gap de durabilidad documentado en docs/persistence/10-DECISIONES.md.

model OutboxEvent {
  // A diferencia de User/Role/Session (agregados de dominio, id generado por EntityId.
  // generate() en domain/), OutboxEvent es un envelope tecnico sin identidad de negocio -
  // aca si tiene sentido dejar que la base genere el id.
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  // Opaco a proposito (docs/persistence/02-TABLAS.md SS6: "nunca FK hacia el agregado que lo
  // origino"), no @db.Uuid - LoginFailed.v1 no tiene Session/User real que referenciar
  // (login con email desconocido), usa el email tal cual como identificador del intento.
  aggregateId   String    @map("aggregate_id")
  companyId     String?   @map("company_id") @db.Uuid
  sourceSchema  String    @map("source_schema")
  payload       Json
  occurredAt    DateTime  @map("occurred_at")
  publishedAt   DateTime? @map("published_at")

  @@index([publishedAt], map: "outbox_event_published_at_idx")
  @@map("outbox_event")
  @@schema("support")
}
