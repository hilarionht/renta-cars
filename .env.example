# Ver docs/engineering/07-CONFIGURATION.md SS1 — un namespace por responsabilidad
# transversal, cada uno validado fail-fast al arrancar (SS4, apps/api/src/config/). Solo
# los namespaces con consumidor real hasta este paso del bootstrap
# (docs/engineering/10-BOOTSTRAP-PLAN.md, paso 8); el resto se agrega cuando exista codigo
# que los consuma.
#
# Copiar a `.env` (no versionado) para desarrollo local: los valores de abajo ya coinciden
# con las credenciales de desarrollo de docker-compose.override.yml.

# --- app ---
# Sin secretos. NODE_ENV/LOG_LEVEL/PORT tienen default seguro (docs/engineering/
# 07-CONFIGURATION.md SS4) - no es obligatorio declararlos, se listan para que sean
# descubribles sin prueba y error.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Sin apps/web-admin todavia (paso 13) - vacio por ahora: CORS no permite ningun origen
# cross-site hasta que se declare uno explicito (nunca "*", docs/technical/07-SECURITY.md SS4).
CORS_ORIGINS=

# --- database ---
# POSTGRES_* los consume el contenedor de docker-compose.yml para inicializar la base;
# DATABASE_URL lo consume la app (Prisma). Credenciales triviales de desarrollo local -
# nunca las mismas que cualquier entorno remoto (docs/engineering/06-DOCKER.md SS4).
POSTGRES_USER=renta
POSTGRES_PASSWORD=renta
POSTGRES_DB=renta
DATABASE_URL=postgresql://renta:renta@localhost:5432/renta
# Rol separado para runtime de la app (docs/persistence/06-RLS.md §3) - `renta` es dueño de
# las tablas y corre las migraciones (Prisma Migrate), nunca la app en runtime; app_runtime
# no es owner, esta sujeto a RLS de verdad. Creado por la migracion identity_rls. Credencial
# de desarrollo trivial, igual criterio que el resto de este archivo.
APP_DATABASE_URL=postgresql://app_runtime:app_runtime@localhost:5432/renta
# Rol con BYPASSRLS, usado exclusivamente por PlatformAdminPrismaService (segundo
# PrismaClient) para el unico caso de uso cross-tenant construido hoy (docs/persistence/
# 06-RLS.md SS5, docs/persistence/10-DECISIONES.md #121) - nunca el pool normal de apps/api.
# Creado por la migracion platform_admin_role. Credencial de desarrollo trivial, igual
# criterio que el resto de este archivo.
PLATFORM_ADMIN_DATABASE_URL=postgresql://platform_admin:platform_admin@localhost:5432/renta

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- storage (MinIO local, StorageProviderPort) ---
# Puerto 9002 en vez del 9000 documentado en docs/engineering/06-DOCKER.md SS3: en esta
# maquina el 9000 ya estaba en uso por otro proceso. Ver docker-compose.override.yml.
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_BUCKET=renta-dev
STORAGE_ACCESS_KEY=renta
STORAGE_SECRET_KEY=renta1234
STORAGE_REGION=us-east-1
# Opcional, tiene default en codigo (storage.config.ts) - tope de tamano de subida,
# enforcement post-hoc en ConfirmUploadHandler (docs/persistence/10-DECISIONES.md).
STORAGE_MAX_UPLOAD_BYTES=20971520

# --- payments (PaymentGatewayPort, docs/11-INTEGRACIONES.md SS6) ---
# fake|stripe|mercadopago - default "fake" en codigo (payments.config.ts) si se omite. Los 3
# adaptadores son codigo real y completo, pero Stripe/MercadoPago no se verificaron contra su
# API viva en esta tanda por falta de credenciales de desarrollo (docs/persistence/
# 10-DECISIONES.md, Fase 2). "fake" es la unica opcion ejercida end-to-end en este entorno.
PAYMENT_GATEWAY_PROVIDER=fake
# Solo necesarios si PAYMENT_GATEWAY_PROVIDER=stripe. Nunca un valor real aqui.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Solo necesarios si PAYMENT_GATEWAY_PROVIDER=mercadopago. Nunca un valor real aqui.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- notifications (NOTIFICATION_SENDER_PORT/PUSH_NOTIFICATION_SENDER_PORT,
# docs/11-INTEGRACIONES.md SS3-5) ---
# fake|real - default "fake" en codigo (notifications.config.ts) si se omite. Los 4
# adaptadores (WhatsApp/SendGrid/Twilio/Expo) son codigo real y completo, pero no se
# verificaron contra su API viva en esta tanda por falta de credenciales de desarrollo
# (docs/persistence/10-DECISIONES.md, Fase 3). "fake" es la unica opcion ejercida
# end-to-end en este entorno.
NOTIFICATION_SENDER_PROVIDER=fake
# Solo necesarios si NOTIFICATION_SENDER_PROVIDER=real. Nunca un valor real aqui.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_PUSH_ACCESS_TOKEN=

# --- jwt (docs/technical/07-SECURITY.md SS1) ---
# Secreto: nunca un valor real aqui. Generar un par de desarrollo con
# `npm run security:generate-jwt-keys` y pegar su salida completa aca abajo.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACTIVE_KID=
JWT_ACCESS_TTL=900

# --- mfa (MfaSecretCipher, docs/persistence/10-DECISIONES.md #111) ---
# Secreto: nunca un valor real aqui. Generar con `openssl rand -hex 32` (hex de 32 bytes).
MFA_SECRET_ENCRYPTION_KEY=

# --- observability (docs/engineering/08-OBSERVABILITY-BOOTSTRAP.md SS1) ---
# Sin secretos. Default seguro si no se declaran (observability.config.ts) - sin el perfil
# `docker-compose.observability.yml` levantado, el SDK de OpenTelemetry simplemente falla
# en exportar sin bloquear la app.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=api
