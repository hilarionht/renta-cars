{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "../../dist/out-tsc",
    "sourceMap": false,
    "module": "commonjs"
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ],
  "// exclude": "playwright.config.mts usa import.meta (ESM) y este tsconfig es commonjs; Playwright la carga como ESM aparte (#146).",
  "exclude": ["playwright.config.mts"]
}
