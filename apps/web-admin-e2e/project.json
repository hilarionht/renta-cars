{
  "name": "web-admin-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-admin-e2e/src",
  "projectType": "application",
  "tags": ["type:e2e"],
  "// e2e": "docs/persistence/10-DECISIONES.md #146: recorridos de la web con Playwright (Chromium). El globalSetup levanta Postgres y Redis por testcontainers y el API compilado (por eso dependsOn api:build); el webServer hace next build + next start. Sin imports de web-admin ni de api: implicitDependencies para que nx affected lo incluya cuando cambian. En local: WEB_E2E_EXTERNAL=1 (API y web de desarrollo, ver docs/engineering/11-ENTORNO-LOCAL-NATIVO.md).",
  "implicitDependencies": ["web-admin", "api"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["api:build"],
      "options": {
        "cwd": "apps/web-admin-e2e",
        "command": "playwright test"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "^{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tooling/testing/**/*",
        "{workspaceRoot}/prisma/**/*",
        { "env": "WEB_E2E_EXTERNAL" },
        { "externalDependencies": ["@playwright/test"] }
      ],
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/web-admin-e2e/test-output",
        "{workspaceRoot}/dist/.playwright/apps/web-admin-e2e/playwright-report"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/web-admin-e2e"
      },
      "cache": true,
      "inputs": ["default", "^production"]
    }
  }
}
